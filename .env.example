# ── Server & Deployment ─────────────────────────────────────────
PORT=5000
NODE_ENV=production
CLIENT_URL=https://dworld.ink

# ── MongoDB Database ───────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dworld?retryWrites=true&w=majority

# ── JSON Web Token (JWT) ───────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_min_32_characters_long
JWT_EXPIRES_IN=30d

# ── Paystack Payments (NGN) ────────────────────────────────────
# Live or Test Keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key

# ── Cloudinary Media Storage ───────────────────────────────────
# From https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email Service: Brevo HTTP API (Port 443 - Recommended for Render) ──
# From https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender@domain.com

# ── Email Service: Gmail SMTP Fallback (Port 465) ─────────────
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_google_app_password
